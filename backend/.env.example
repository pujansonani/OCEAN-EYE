# OCEAN-EYE Environment Configuration

# DataDocked Live AIS Gateway (https://datadocked.com)
DATADOCKED_API_KEY=your_datadocked_api_key_here
DATADOCKED_BASE_URL=https://datadocked.com/api/vessels_operations/get-vessel-info

# MyShipTracking v2 Maritime API (https://api.myshiptracking.com)
MYSHIPTRACKING_API_KEY=your_myshiptracking_api_key_here
MYSHIPTRACKING_SECRET_KEY=your_myshiptracking_secret_key_here
MYSHIPTRACKING_BASE_URL=https://api.myshiptracking.com/api/v2

# Server Configuration
PORT=8000
PYTHONUNBUFFERED=1
